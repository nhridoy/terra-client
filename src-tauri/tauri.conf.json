{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermVault",
  "version": "1.0.0",
  "mainBinaryName": "TermVault",
  "identifier": "com.termvault.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "TermVault",
      "width": 1200,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "decorations": true,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' http://localhost:* https://localhost:* tauri: ws://localhost:* wss://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "headerImage": "../../assets/header.bmp",
        "sidebarImage": "../../assets/sidebar.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {"x": 180, "y": 170},
        "applicationFolderPosition": {"x": 480, "y": 170}
      }
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "libappindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://releases.termvault.app/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGZvciBkZXZlbG9wbWVudCwgbm90IHByb2R1Y3Rpb24="
    }
  }
}
