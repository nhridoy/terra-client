{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "TermVault",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": false,
        "open": true
      },
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "path": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true
      },
      "updater": {
        "all": true,
        "check": true,
        "download": true
      }
    },
    "updater": {
      "active": true,
      "dialogUpToDate": true,
      "endpoints": [
        "https://releases.termvault.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGZvciBkZXZlbG9wbWVudCwgbm90IHByb2R1Y3Rpb24="
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.termvault.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "nsis": {
          "installMode": "both",
          "license": "../../LICENSE",
          "headerImage": "../../assets/header.bmp",
          "sidebarImage": "../../assets/sidebar.bmp"
        }
      },
      "macOS": {
        "dmg": {
          "appPosition": {
            "x": 180,
            "y": 170
          },
          "applicationFolderPosition": {
            "x": 480,
            "y": 170
          }
        }
      },
      "linux": {
        "deb": {
          "depends": ["libgtk-3-0", "libwebkit2gtk-4.0-37", "libappindicator3-1"]
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "TermVault",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ]
  }
}
