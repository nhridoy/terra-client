{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main",
    "splashscreen"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:event:default",
    "shell:allow-open",
    "dialog:default",
    "store:default",
    "pty:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**/*"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "C:/**/*"
        },
        {
          "path": "D:/**/*"
        },
        {
          "path": "/**"
        }
      ]
    },
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**/*"
        },
        {
          "path": "C:/**/*"
        },
        {
          "path": "D:/**/*"
        },
        {
          "path": "/**"
        }
      ]
    },
    "keyring-store:default"
  ]
}